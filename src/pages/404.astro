---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面不存在或已经移动">
  <main class="container not-found">
    <div class="about-eyebrow">404</div>
    <h1>页面不存在</h1>
    <p>可能是链接写错了，或者这篇文章后来移动了位置。</p>
    <div class="about-links">
      <a href="/">回首页 &rarr;</a>
      <a href="/archive/">看归档 &rarr;</a>
    </div>
  </main>
</BaseLayout>
