---
import BaseLayout from './BaseLayout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import TOC from '../components/TOC.astro';

interface AdjacentPost {
  title: string;
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  tag: string;
  readMin: number;
  headings: any[];
  series?: string;
  topics?: string[];
  previousPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const {
  title,
  description,
  date,
  tag,
  readMin,
  headings,
  series,
  topics = [],
  previousPost,
  nextPost,
} = Astro.props;
const dateStr = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={date}
  author="北渚"
  section={tag}
  tags={[tag, series, ...topics].filter(Boolean)}
>
  <ProgressBar />
  <main class="container-wide article">
    <div class="article-layout">
      <article>
        <header class="article-header">
          <div class="article-kicker">
            <span class="tag-badge" data-tag={tag}>{tag}</span>
            {series && <span class="series-chip">{series}</span>}
          </div>
          <h1>{title}</h1>
          <div class="article-meta">
            <span>{dateStr}</span>
            <span class="dot"></span>
            <span>约 {readMin} 分钟阅读</span>
            <span class="dot"></span>
            <span>北渚</span>
          </div>
          {topics.length > 0 && (
            <div class="topic-list" aria-label="文章主题">
              {topics.map((topic) => <span>{topic}</span>)}
            </div>
          )}
        </header>
        <div class="article-body">
          <slot />
        </div>
        <div class="article-end">
          <p class="signature">— 北渚</p>
          <p>谢谢你读到这里。</p>
        </div>
        {(previousPost || nextPost) && (
          <nav class="post-pager" aria-label="文章导航">
            {previousPost ? (
              <a href={previousPost.href} class="pager-link pager-prev">
                <span>{previousPost.label}</span>
                <strong>{previousPost.title}</strong>
              </a>
            ) : <span></span>}
            {nextPost ? (
              <a href={nextPost.href} class="pager-link pager-next">
                <span>{nextPost.label}</span>
                <strong>{nextPost.title}</strong>
              </a>
            ) : <span></span>}
          </nav>
        )}
        <a href="/" class="back-link">&larr; 回首页</a>
      </article>
      <TOC headings={headings} />
    </div>
  </main>
</BaseLayout>

