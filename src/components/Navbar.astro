---
const { activeNav = '' } = Astro.props;
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand">
      <span class="star">✦</span>
      <span class="brand-text">北渚的博客</span>
    </a>
    <div class="nav-links">
      <a href="/" class={activeNav === 'posts' ? 'active' : ''}>日记</a>
      <a href="/archive/" class={activeNav === 'archive' ? 'active' : ''}>归档</a>
      <a href="/about" class={activeNav === 'about' ? 'active' : ''}>关于</a>
      <a href="/rss.xml" aria-label="订阅">订阅</a>
      <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">
        <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (_) {}
    });
  })();
</script>
